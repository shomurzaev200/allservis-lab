[Unit]
Description=All Servis
After=network.target postgresql.service
StartLimitBurst=12
StartLimitIntervalSec=120

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/allservis
EnvironmentFile=-/opt/allservis/.env
Environment=NODE_ENV=development
Environment=PATH=/opt/allservis/node_modules/.bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/node scripts/migrate.mjs
ExecStart=/usr/bin/node scripts/with-app-env.mjs ./node_modules/.bin/vite dev --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
