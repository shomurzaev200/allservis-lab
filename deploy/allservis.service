[Unit]
Description=All Servis
After=network.target postgresql.service
StartLimitBurst=8
StartLimitIntervalSec=60

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/fjord-acre-sky-solar
EnvironmentFile=-/home/ubuntu/fjord-acre-sky-solar/.env
Environment=NODE_ENV=development
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
Environment=PATH=/home/ubuntu/fjord-acre-sky-solar/node_modules/.bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/node scripts/migrate.mjs
ExecStart=/usr/bin/node scripts/with-app-env.mjs ./node_modules/.bin/vite dev --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
